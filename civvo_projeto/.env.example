# URL base da API do back-end.
# Em desenvolvimento deixe VAZIO: o front usa "/api" e o proxy do Vite (vite.config.js) encaminha para o back.
# Em produção (ex.: Vercel) informe a URL pública do back, terminando em /api:
#   VITE_API_URL=https://seu-backend.exemplo.com/api
VITE_API_URL=

# Destino do proxy em desenvolvimento (padrão: http://localhost:8080)
VITE_PROXY_TARGET=http://localhost:8080

# Client ID do Google (OAuth "Aplicativo da Web") usado no login/cadastro com Google do doador.
# Precisa ser o MESMO valor de GOOGLE_CLIENT_ID no .env do back.
# No Google Cloud Console, em "Origens JavaScript autorizadas", adicione http://localhost:5173 (e a URL de produção).
VITE_GOOGLE_CLIENT_ID=
